{
    "name": "conversa",
    "version": "1.0.0",
    "description": "JavaScript utilities for the Conversa Laravel package",
    "main": "resources/js/conversa.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "build": "rollup -c",
        "dev": "rollup -c -w",
        "lint": "eslint resources/js/**/*.js",
        "format": "prettier --write resources/js/**/*.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yourusername/conversa.git"
    },
    "keywords": [
        "laravel",
        "chat",
        "messaging",
        "real-time"
    ],
    "author": "Your Name",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/yourusername/conversa/issues"
    },
    "homepage": "https://github.com/yourusername/conversa#readme",
    "devDependencies": {
        "@babel/core": "^7.22.0",
        "@babel/preset-env": "^7.22.0",
        "@rollup/plugin-babel": "^6.0.0",
        "@rollup/plugin-commonjs": "^25.0.0",
        "@rollup/plugin-node-resolve": "^15.0.0",
        "babel-jest": "^29.0.0",
        "eslint": "^8.40.0",
        "eslint-config-prettier": "^8.8.0",
        "jest": "^29.0.0",
        "jest-environment-jsdom": "^29.0.0",
        "prettier": "^2.8.0",
        "rollup": "^3.23.0",
        "rollup-plugin-terser": "^7.0.0"
    },
    "dependencies": {
        "laravel-echo": "^1.15.0",
        "pusher-js": "^8.0.0"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "moduleFileExtensions": [
            "js",
            "json"
        ],
        "transform": {
            "^.+\\.js$": "babel-jest"
        },
        "testRegex": "tests/js/.*\\.test\\.js$",
        "setupFiles": [
            "<rootDir>/tests/js/setup.js"
        ],
        "collectCoverageFrom": [
            "resources/js/**/*.js"
        ],
        "coverageDirectory": "coverage",
        "coverageReporters": [
            "text",
            "lcov"
        ]
    },
    "babel": {
        "presets": [
            [
                "@babel/preset-env",
                {
                    "targets": {
                        "node": "current"
                    }
                }
            ]
        ]
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": true,
        "printWidth": 100
    },
    "eslintConfig": {
        "env": {
            "browser": true,
            "es2021": true,
            "jest": true
        },
        "extends": [
            "eslint:recommended",
            "prettier"
        ],
        "parserOptions": {
            "ecmaVersion": 12,
            "sourceType": "module"
        },
        "rules": {
            "no-console": "warn",
            "no-unused-vars": "warn"
        }
    }
}
